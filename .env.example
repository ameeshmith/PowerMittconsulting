# PowerMitt Environment Variables Template
# Web3Forms Public Access Key (Ensure "Domain Restriction" is enabled in Web3Forms dashboard for powermitt.com.au / ameeshmith.github.io)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# SHA-256 hash of author passcode
VITE_ADMIN_PASSCODE_HASH=your_admin_passcode_sha256_hash_here

# Public canonical site URL
VITE_SITE_URL=https://ameeshmith.github.io/PowerMittconsulting
